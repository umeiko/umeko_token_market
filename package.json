{
  "name": "umeko-token-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloud API gateway and local connector for self-hosted OpenAI-compatible models",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "agent": "node agent/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:ui": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.2",
    "nodemailer": "^10.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "vite": "^8.3.4",
    "vue": "^3.5.26"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
