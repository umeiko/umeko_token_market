[Unit]
Description=Umeko private remote workspace
After=network-online.target umeko-guacd.service
Wants=network-online.target umeko-guacd.service

[Service]
Type=simple
User=umeko-remote
Group=umeko-remote
WorkingDirectory=/opt/umeko-token-relay
Environment=UMEKO_REMOTE_CONFIG=/etc/umeko-remote/server.json
ExecStart=/usr/bin/node /opt/umeko-token-relay/remote/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/umeko-remote
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
